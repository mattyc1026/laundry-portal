# Optional. Without these the app uses the household's existing project,
# laundry-portal-12662, which is what the previous deployment used.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_DATABASE_URL=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=

# Subtree this build reads and writes. Change it to start from a clean slate
# without disturbing whatever the old deployment left behind.
VITE_FB_ROOT=portal/v3
